<% if @article.errors.any? %>
<h2>The following errors were found</h2>
<ul type = "circle">
<% @article.errors.full_messages.each do |msg| %>
    <li><%= msg %></li>
    <% end %>
<% end %>
</ul>

<%#= form_with scope: :article,url: articles_path, locals:true, data: {turbo: false}  do |f| %>  # post
<%#= form_with model: @article,url: article_path(@article), local:true,data:{turbo:false} do |f| %> #put

<%= form_with model: @article, local: true, data:{turbo: false} do |f| %>
    <p>
        <%= f.label :title %><br/>
        <%= f.text_field :title %>
    </p>
    <p>
        <%= f.label :description %><br/>
        <%= f.text_area :description %>
    </p>
    <p>
    <%= f.submit %>
    </p>
<% end %>